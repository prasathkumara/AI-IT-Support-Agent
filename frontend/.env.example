# =============================================================================
# Frontend environment template (.env.example)
# =============================================================================
# This is a TEMPLATE, not a real config file. It lists the environment
# variables the frontend expects, with placeholder values only.
#
# How to use it:
#   1. Copy this file to a new file named ".env" in this same folder.
#        (macOS/Linux)  cp .env.example .env
#        (Windows)      copy .env.example .env
#   2. Fill in your real values in ".env". Your ".env" is git-ignored, so your
#      local values never get committed.
#
# IMPORTANT — the NEXT_PUBLIC_ prefix:
#   In Next.js, any variable that starts with NEXT_PUBLIC_ is embedded into the
#   browser bundle, so it is VISIBLE to anyone using the site. That is fine for
#   non-sensitive values like a public API URL or an app name.
#   NEVER put secrets (API keys, passwords, tokens) in a NEXT_PUBLIC_ variable.
#   Server-only secrets belong in the backend's own .env, not here.
# =============================================================================

# Required — Base URL where the frontend finds the backend API.
# During local development the backend runs on port 8000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional — Display name shown in the UI.
NEXT_PUBLIC_APP_NAME=AI IT Support Platform
