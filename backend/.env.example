# =============================================================================
# Backend Environment Variables — TEMPLATE (.env.example)
# =============================================================================
#
# HOW TO USE THIS FILE
#   1. Copy this file to a new file named ".env" in the same folder.
#         (On macOS/Linux:  cp .env.example .env)
#   2. Replace every "your-..." placeholder below with your REAL value.
#   3. Never commit the real ".env" file — it is git-ignored on purpose.
#
# IMPORTANT — PHASE 1 NOTE
#   In Phase 1 the backend only serves the GET /health endpoint and does NOT
#   read any of these variables yet. They are documented here so you know what
#   each later phase will need. You can leave the placeholders as-is for now.
#
# SECURITY
#   This template contains PLACEHOLDER (non-real) values only. Do NOT put real
#   secrets in this file. Real secrets belong only in your local ".env".
#
# LEGEND
#   [Required later] = the app WILL need this in a later phase to function.
#   [Optional]       = only set these if you use that specific provider.
# =============================================================================


# -----------------------------------------------------------------------------
# Database — MongoDB Atlas   [Required later]
# -----------------------------------------------------------------------------
# The connection string points the app at your MongoDB database.
# MONGODB_DATABASE is the logical database name used inside that cluster.
MONGODB_URI=your-mongodb-atlas-connection-string
MONGODB_DATABASE=ai_it_support


# -----------------------------------------------------------------------------
# Claude LLM (large language model)   [Required later]
# -----------------------------------------------------------------------------
# CLAUDE_API_KEY authenticates calls to the Claude API.
# CLAUDE_MODEL selects which Claude model version to use.
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_MODEL=claude-model-name


# -----------------------------------------------------------------------------
# Embeddings (used by the RAG subsystem to turn text into vectors)   [Required later]
# -----------------------------------------------------------------------------
# EMBEDDING_PROVIDER selects which embedding backend to use ("local" uses the
#   offline sentence-transformers model — no API key needed).
# EMBEDDING_MODEL selects the specific model that provider loads.
# EMBEDDING_DIMENSION is the vector length that model produces. It MUST match
#   the MongoDB Atlas vector index dimension, so keep them in sync.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384


# -----------------------------------------------------------------------------
# File storage — Azure Blob Storage   [Optional]
# -----------------------------------------------------------------------------
# Choose ONE file-storage provider (Azure OR AWS S3), not both.
# Set these two only if you use Azure Blob Storage.
AZURE_STORAGE_CONNECTION_STRING=your-azure-connection-string
AZURE_STORAGE_CONTAINER=your-azure-container


# -----------------------------------------------------------------------------
# File storage — AWS S3   [Optional]
# -----------------------------------------------------------------------------
# Choose ONE file-storage provider (Azure OR AWS S3), not both.
# Set these two only if you use AWS S3.
AWS_S3_BUCKET=your-s3-bucket
AWS_REGION=your-aws-region


# -----------------------------------------------------------------------------
# Microsoft Entra ID (identity / authentication)   [Optional]
# -----------------------------------------------------------------------------
# Only needed in the later authentication phase. Leave as placeholders for now.
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-client-id
ENTRA_CLIENT_SECRET=your-client-secret
